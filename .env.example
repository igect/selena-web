# Public Configuration (Safe for frontend bundle & GitHub Actions variables)
# Get these from: Supabase Dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
PUBLIC_MEDIA_CDN_URL=https://media.archive.example.com

# Private Secrets (For backend migration scripts & CLI ONLY — NEVER expose to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Cloudflare R2 Credentials (if using R2 instead of Supabase Storage)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=selena-archive-media
